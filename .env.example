### Example environment variables for local development
# Copy this file to `.env.local` or `.env` and fill values. DO NOT commit real secrets.

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=GlowLink Beauty
VITE_APP_VERSION=1.0.0

# Authentication
VITE_JWT_SECRET=replace_with_a_strong_jwt_secret

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Optional realtime / websocket
VITE_WS_URL=ws://localhost:8080

# Optional Stripe API URL for frontend helper (if used)
VITE_STRIPE_API_URL=http://localhost:3000/api/stripe

# Server (do NOT commit STRIPE_SECRET_KEY)
# STRIPE_SECRET_KEY=sk_test_...
